{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Locatarr Application Definition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "github_slug": {
            "type": "string"
          },
          "subreddit": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ]
      }
    }
  },
  "required": [
    "applications"
  ]
}
